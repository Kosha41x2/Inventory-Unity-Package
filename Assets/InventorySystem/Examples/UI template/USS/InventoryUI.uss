:root {
}

.pannel {
    background-color: rgb(178, 184, 195);
    width: 70%;
    height: 40%;
    max-height: none;
    top: 20%;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.background {
    align-items: center;
    justify-content: center;
    align-content: center;
}

.itemSlot {
    width: 10%;
    aspect-ratio: 1;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    background-color: rgb(82, 87, 97);
}

.slotRow {
    flex-direction: row;
    align-items: center;
}

.itemFrame {
    width: 100%;
    height: 100%;
    flex-direction: column-reverse;
    align-items: flex-end;
}

.itemSlot:hover {
    background-color: rgb(65, 96, 191);
}

.stackSize {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(218, 218, 218);
}

.element {
    align-self: flex-start;
    width: 25%;
    height: 25%;
    aspect-ratio: 1;
    bottom: 75%;
}

.damage {
    top: 75%;
    color: rgb(218, 218, 218);
    font-size: 15px;
    -unity-font-style: bold;
}
